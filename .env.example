# Discord bot token (from https://discord.com/developers/applications -> Bot)
DISCORD_TOKEN=

# Application ID (from the General Information page)
DISCORD_APP_ID=

# Optional: register commands to a single guild (instant). Leave empty for global (~1h).
DISCORD_GUILD_ID=

# Host path where downloaded files should land.
# IMPORTANT: this is the path on the HOST (Docker daemon's view),
# because the bot mounts it into sibling containers it spawns.
DOWNLOAD_HOST_PATH=/srv/listen/downloads

# Optional: override the image used for downloads.
DOWNLOADER_IMAGE=listen-downloader:latest
